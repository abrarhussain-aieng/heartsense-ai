# ===== DagsHub =====
DAGSHUB_REPO_OWNER=your_username
DAGSHUB_REPO_NAME=heartsense-ai
DAGSHUB_TOKEN=your_dagshub_token

# ===== MLflow via DagsHub =====
MLFLOW_TRACKING_URI=https://dagshub.com/your_username/heartsense-ai.mlflow
MLFLOW_TRACKING_USERNAME=your_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token
MLFLOW_EXPERIMENT=heartsense-heart-disease

# ===== Gemini (primary) =====
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ===== Groq (fallback) =====
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# ===== MCP =====
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_AUTH_TOKEN=change_me_long_random_string

# ===== LangSmith =====
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=heartsense-ai
LANGSMITH_TRACING=false